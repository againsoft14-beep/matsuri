{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-pathao" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-truck"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-pathao" class="form-horizontal">

          <fieldset>
            <legend>General</legend>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="shipping_pathao_status" class="form-control">
                  <option value="1" {% if shipping_pathao_status %}selected{% endif %}>{{ text_enabled }}</option>
                  <option value="0" {% if not shipping_pathao_status %}selected{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_sandbox }}</label>
              <div class="col-sm-10">
                <select name="shipping_pathao_sandbox" class="form-control">
                  <option value="1" {% if shipping_pathao_sandbox %}selected{% endif %}>{{ text_sandbox }}</option>
                  <option value="0" {% if not shipping_pathao_sandbox %}selected{% endif %}>{{ text_live }}</option>
                </select>
                <p class="help-block">{{ help_env_override }}</p>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_logging }}</label>
              <div class="col-sm-10">
                <select name="shipping_pathao_logging" class="form-control">
                  <option value="1" {% if shipping_pathao_logging %}selected{% endif %}>{{ text_enabled }}</option>
                  <option value="0" {% if not shipping_pathao_logging %}selected{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_cron_token }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_pathao_cron_token" value="{{ shipping_pathao_cron_token }}" class="form-control" />
                <p class="help-block">{{ help_cron_token }}{% if pathao_cron_url %}<br><code style="word-break:break-all;">{{ pathao_cron_url }}</code>{% endif %}</p>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_webhook_secret }}</label>
              <div class="col-sm-10">
                <input type="password" name="shipping_pathao_webhook_secret" value="{{ shipping_pathao_webhook_secret }}" class="form-control" autocomplete="new-password" />
                <p class="help-block">{{ help_webhook_secret }}{% if pathao_webhook_url %}<br><code style="word-break:break-all;">{{ pathao_webhook_url }}</code>{% endif %}</p>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>API Credentials</legend>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_client_id }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_pathao_client_id" value="{{ shipping_pathao_client_id }}" class="form-control" />
                <p class="help-block">{{ help_client_id }}</p>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_client_secret }}</label>
              <div class="col-sm-10">
                <input type="password" name="shipping_pathao_client_secret" value="{{ shipping_pathao_client_secret }}" class="form-control" autocomplete="new-password" />
                <p class="help-block">{{ help_client_secret }}</p>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_username }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_pathao_merchant_username" value="{{ shipping_pathao_merchant_username }}" class="form-control" />
                <p class="help-block">{{ help_username }}</p>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_password }}</label>
              <div class="col-sm-10">
                <input type="password" name="shipping_pathao_merchant_password" value="{{ shipping_pathao_merchant_password }}" class="form-control" autocomplete="new-password" />
                <p class="help-block">{{ help_password }}</p>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Stores</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_default_store }}</label>
              <div class="col-sm-10">
                <select name="shipping_pathao_default_store_id" class="form-control">
                  <option value="0">-- Select --</option>
                  {% for s in pathao_stores %}
                    <option value="{{ s.store_id }}" {% if s.is_default or (shipping_pathao_default_store_id and shipping_pathao_default_store_id == s.store_id) %}selected{% endif %}>{{ s.store_name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>

            <div class="form-group">
              <div class="col-sm-10 col-sm-offset-2">
                <button type="button" id="btn-test" class="btn btn-info"><i class="fa fa-plug"></i> {{ button_test_connection }}</button>
                <button type="button" id="btn-sync" class="btn btn-success"><i class="fa fa-refresh"></i> {{ button_sync_stores }}</button>
                <span id="pathao-status" class="label label-default" style="margin-left:10px;">Idle</span>
                <p class="help-block" style="margin-top:8px;">{{ help_test_connection }}</p>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  function setStatus(text, cls) {
    var el = $('#pathao-status');
    el.removeClass('label-default label-success label-danger label-warning').addClass(cls || 'label-default').text(text);
  }

  $('#btn-test').on('click', function() {
    setStatus('Testing...', 'label-warning');
    $.ajax({
      url: '{{ test_connection_url }}',
      type: 'POST',
      data: $('#form-pathao').serialize(),
      dataType: 'text'
    }).done(function(raw) {
      if (typeof raw === 'string' && raw.trim().charAt(0) === '<') {
        setStatus('Session expired. Reload page.', 'label-danger');
        return;
      }
      var res = {};
      try { res = JSON.parse(raw); } catch(e) {}
      if (res && res.success) setStatus(res.message || 'Connected', 'label-success');
      else setStatus((res && res.message) ? res.message : 'Failed', 'label-danger');
    }).fail(function(xhr) {
      setStatus('Error: ' + (xhr.status || ''), 'label-danger');
    });
  });

  $('#btn-sync').on('click', function() {
    setStatus('Syncing...', 'label-warning');
    $.ajax({
      url: '{{ sync_stores_url }}',
      type: 'POST',
      data: $('#form-pathao').serialize(),
      dataType: 'json'
    }).done(function(res) {
      if (res && res.success) setStatus(res.message || 'Synced', 'label-success');
      else setStatus((res && res.message) ? res.message : 'Failed', 'label-danger');
    }).fail(function(xhr) {
      setStatus('Error: ' + (xhr.status || ''), 'label-danger');
    });
  });
})();
</script>

{{ footer }}

