<div id="archiveWrapper{{ store.store_id }}"></div>

<script>
$(document).ready(function(){
    $.ajax({
        url: "index.php?route={{ modulePath }}/getarchive&store_id={{ store.store_id }}&user_token={{ user_token }}&page=1",
        type: 'get',
        dataType: 'html',
        success: function(data) {
            $("#archiveWrapper{{ store.store_id }}").html(data);
        }
    });
});
</script>
