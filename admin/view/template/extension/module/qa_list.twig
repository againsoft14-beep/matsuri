{% macro alert_icon(type) %}{% spaceless %}
		{% if type == 'error' %}
			fa-times-circle
		{% elseif type == 'warning' %}
			fa-exclamation-triangle
		{% elseif type == 'success' %}
			fa-check-circle
		{% elseif type == 'info' %}
			fa-info-circle
		{% else %}
		{% endif %}
{% endspaceless %}{% endmacro %}
{{ header }}
<!-- confirm deletion -->
<div class="modal fade" id="confirmDelete" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
				<h4 class="modal-title" id="confirmDeleteLabel">{{ text_confirm_delete }}</h4>
			</div>
			<div class="modal-body">
				<p>{{ text_are_you_sure }}</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-ban"></i> {{ button_cancel }}</button>
				<button type="button" class="btn btn-danger delete"><i class="fa fa-trash-o"></i> {{ button_delete }}</button>
			</div>
		</div><!-- /.modal-content -->
	</div><!-- /.modal-dialog -->
</div><!-- /.modal -->
{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="button" class="btn btn-primary" data-toggle="tooltip" data-container="body" data-placement="bottom" title="{{ button_add }}" data-url="{{ add }}" id="btn-insert" data-form="#qa-list-form" data-context="#content" data-overlay="#page-overlay"><i class="fa fa-plus"></i></button>
				<button type="button" class="btn btn-default" data-toggle="tooltip" data-container="body" data-placement="bottom" title="{{ button_copy }}" data-url="{{ copy }}" id="btn-copy" data-form="#qa-list-form" data-context="#content" data-overlay="#page-overlay" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" disabled><i class="fa fa-files-o"></i></button>
				<button type="button" class="btn btn-danger" data-toggle="tooltip" data-container="body" data-placement="bottom" title="{{ button_delete }}" data-url="{{ delete }}" id="btn-delete" data-form="#qa-list-form" data-context="#content" data-overlay="#page-overlay" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" disabled><i class="fa fa-trash-o"></i></button>
			</div>
			<h1><i class="fa fa-question-circle fa-fw ext-icon"></i> {{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
				<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>

	<div class="alerts">
		<div class="container-fluid" id="alerts">
			{% for type, _alerts in alerts %}
				{% for alert in _alerts %}
					{% if alert %}
			<div class="alert alert-{% if type == "error" %}danger{% else %}{{ type }}{% endif %} fade in">
				<button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
				<i class="fa {{ _self.alert_icon(type) }}"></i>{{ alert }}
			</div>
					{% endif %}
				{% endfor %}
			{% endfor %}
		</div>
	</div>

	<div class="container-fluid bull5i-content bull5i-container">
		<div id="page-overlay" class="bull5i-overlay fade in">
			<div class="page-overlay-progress"><i class="fa fa-refresh fa-spin fa-5x text-muted"></i></div>
		</div>
		<div class="row navbar-bull5i">
			<div class="pull-right">
				<div class="nav navbar-nav navbar-form" id="nav-filter">
					<div class="form-group search-form">
						<label for="global-search" class="sr-only">{{ text_search }}</label>
						<div class="search">
							<div class="input-group">
								<input type="text" name="search" class="form-control" placeholder="{{ text_search }}" id="global-search" value="{{ search }}">
								<span class="input-group-btn">
									<button type="button" class="btn btn-default" data-toggle="tooltip" data-container="body" data-placement="bottom" title="{{ text_search }}" id="global-search-btn"><i class="fa fa-search fa-fw"></i></button>
									{% if search %}<button type="button" class="btn btn-default" data-toggle="tooltip" data-container="body" data-placement="bottom" title="{{ text_clear_search }}" id="clear-global-search-btn"><i class="fa fa-times fa-fw"></i></button>{% endif %}
								</span>
							</div>
						</div>
					</div>

					{% if multilingual %}
					<div class="form-group">
						<select id="selectLanguage" name="filter_language" class="form-control" data-toggle="tooltip" data-original-title="{{ text_display_language }}" data-placement="bottom">
							<option value=""{% if not filters.language or filters.language == '' %} selected="selected"{% endif %}>{{ text_all_languages }}</option>
							{% for lang in languages %}
							<option value="{{ lang.language_id }}"{% if filters.language == lang.language_id %} selected="selected"{% endif %}>{{ lang.name }}</option>
							{% endfor %}
						</select>
					</div>
					{% endif %}
				</div>
			</div>
		</div>
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
			</div>
			<div class="panel-body">
				<form method="post" enctype="multipart/form-data" id="qa-list-form" class="form-horizontal" role="form">
					<fieldset>
						<div class="table-responsive">
							<table class="table table-bordered table-condensed table-striped table-list table-hover">
								<thead>
									<tr>
										{% for column, attr in columns %}
											{% if column == 'selector' %}
										<th class="{{ attr.align }} {{ attr.class }} col_{{ column }}" width="1"><input type="checkbox" id="master-selector" /></th>
											{% else %}
												{% if attr.sort|length %}
										<th class="{{ attr.align }} {{ attr.class }} col_{{ column }}"><a href="{{ sorts[column] }}">{{ attr.name }}{% if sort == attr.sort %} <i class="fa fa-sort-{{ order|lower }}"></i>{% endif %}</a></th>
												{% else %}
										<th class="{{ attr.align }} {{ attr.class }} col_{{ column }}">{{ attr.name }}</th>
											{% endif %}
										{% endif %}
										{% endfor %}
									</tr>
									<tr class="filters">
										{% for column, attr in columns %}
											{% if column == 'selector' %}
										<td></td>
											{% elseif column == 'status' %}
										<td class="{{ attr.align }} {{ attr.class }}">
											<select name="filter_{{ column }}" class="form-control input-sm fltr {{ column }}" data-column="{{ column }}">
												<option value=""{% if not filters[column] or filters[column] == '' %} selected{% endif %}></option>
												<option value="1"{% if filters[column] == '1' %} selected{% endif %}>{{ text_enabled }}</option>
												<option value="0"{% if filters[column] == '0' %} selected{% endif %}>{{ text_disabled }}</option>
											</select>
										</td>
											{% elseif column == 'action' %}
										<td class="{{ attr.align }} {{ attr.class }}">
											<div class="btn-group">
												<button type="button" class="btn btn-sm btn-default" id="filter" data-toggle="tooltip" title="{{ text_filter }}"><i class="fa fa-filter fa-fw"></i></button>
												<button type="button" class="btn btn-sm btn-default" id="clear-filter" data-toggle="tooltip" title="{{ text_clear_filter }}"><i class="fa fa-times fa-fw"></i></button>
											</div>
										</td>
											{% elseif column == 'store' %}
										<td class="{{ attr.align }} {{ attr.class }}">
											<select name="filter_{{ column }}" class="form-control input-sm fltr {{ column }}" data-column="{{ column }}">
												<option value=""{% if filters[column] != '0' and not filters[column] %} selected{% endif %}></option>
												<option value="*"{% if filters[column] != '0' and filters[column] == '*' %} selected{% endif %}>{{ text_none }}</option>
												{% for s in stores %}
												<option value="{{ s.store_id }}"{% if filters[column] != '' and filters[column] == s.store_id %} selected{% endif %}>{{ s.name }}</option>
												{% endfor %}
											</select>
										</td>
											{% elseif column == 'product' %}
										<td class="{{ attr.align }} {{ attr.class }}"><input type="text" name="filter_{{ column }}" value="{{ filters[column] }}" class="form-control input-sm fltr {{ column }} typeahead" placeholder="{{ text_autocomplete }}" data-column="{{ column }}"></td>
											{% else %}
										<td class="{{ attr.align }} {{ attr.class }}"><input type="text" name="filter_{{ column }}" value="{{ filters[column] }}" class="form-control input-sm fltr {{ column }}" data-column="{{ column }}"></td>
											{% endif %}
										{% endfor %}
									</tr>
								</thead>
								<tbody>
									{% if questions %}
										{% for q in questions %}
									<tr>
											{% for column, attr in columns %}
												{% if column == 'selector' %}
										<td class="{{ attr.align }} {{ attr.class }}"><input type="checkbox" name="selected[]" value="{{ q.qa_id }}"{% if q.selected %} checked{% endif %} /></td>
												{% elseif column == 'status' %}
										<td class="{{ attr.align }} {{ attr.class }}"><span class="label label-{{ q.status_class }}">{{ q[column] }}</span></td>
												{% elseif column == 'question_author_name' %}
										<td class="{{ attr.align }} {{ attr.class }}">
													{% if q.customer_id %}
											<a href="{{ customer ~ q.customer_name }}">{{ q[column] }}</a>
													{% else %}
											{{ q[column] }}
													{% endif %}
													{% if q.author_details %}
											<button type="button" class="btn btn-default btn-xs pull-right" data-toggle="popover" data-placement="right" data-html="true" data-trigger="manual" data-content="{{ q.author_details }}" data-popover-group="author-details"><i class="fa fa-eye"></i></button>
													{% endif %}
										</td>
												{% elseif column == 'question' or column == 'answer' %}
										<td class="{{ attr.align }} {{ attr.class }}">
											{{ q[column] }}
											{% if q[column] != q[column ~ '_full'] %}
											<button type="button" class="btn btn-default btn-xs pull-right" data-toggle="popover" data-placement="right" data-html="true" data-trigger="manual" data-content="{{ q[column ~ '_full'] }}" data-popover-group="{{ column }}"><i class="fa fa-eye"></i></button>
											{% endif %}
										</td>
												{% elseif column == 'action' %}
										<td class="{{ attr.align }} {{ attr.class }} action">
											<div class="btn-group">
												{% for action in q.action %}
													{% if action.url %}
												<a href="{{ action.url }}" id="{{ action.name ~ '-' ~ q.qa_id }}" class="btn {{ action.class }} btn-sm {{ action.name }}" data-toggle="tooltip" title="{{ action.title }}">{% if action.icon %}<i class="fa fa-{{ action.icon }}"></i>{% endif %} <span class="visible-lg-inline">{{ action.text }}</span></a>
													{% else %}
												<button type="button" id="{{ action.name ~ '-' ~ q.qa_id }}" class="btn {{ action.class }} btn-sm {{ action.name }}" data-toggle="tooltip" title="{{ action.title }}">{% if action.icon %}<i class="fa fa-{{ action.icon }}"></i>{% endif %} <span class="visible-lg-inline">{{ action.text }}</span></button>
													{% endif %}
												{% endfor %}
											</div>
										</td>
												{% else %}
										<td class="{{ attr.align }} {{ attr.class }}">{{ q[column] }}</td>
												{% endif %}
											{% endfor %}
									</tr>
										{% endfor %}
									{% else %}
									<tr>
										<td class="text-center" colspan="{{ columns|length }}">{{ text_no_results }}</td>
									</tr>
									{% endif %}
								</tbody>
							</table>
						</div>
					</fieldset>
				</form>
				<div class="row">
					<div class="col-sm-6 text-left">{{ pagination }}</div>
					<div class="col-sm-6 text-right">{{ results }}</div>
				</div>
			</div>
		</div>
	</div>
</div>
