{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ export }}" data-toggle="tooltip" title="Export" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Export</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        <div class="well">
          <div class="row">
            <div class="col-sm-4">
              <div class="form-group">
                <label class="control-label">{{ entry_customer }}</label>
                <input type="text" name="filter_customer" value="{{ filter_customer }}" placeholder="{{ entry_customer }}" class="form-control" />
              </div>
              <div class="form-group">
                <label class="control-label">{{ entry_product }}</label>
                <input type="text" name="filter_product" value="{{ filter_product }}" placeholder="{{ entry_product }}" class="form-control" />
              </div>
            </div>
            <div class="col-sm-4">
              <div class="form-group">
                <label class="control-label">{{ entry_lot_number }}</label>
                <input type="text" name="filter_lot_number" value="{{ filter_lot_number }}" placeholder="{{ entry_lot_number }}" class="form-control" />
              </div>
              <div class="form-group">
                <label class="control-label">{{ entry_phone }}</label>
                <input type="text" name="filter_phone" value="{{ filter_phone }}" placeholder="{{ entry_phone }}" class="form-control" />
              </div>
            </div>
            <div class="col-sm-4">
              <div class="form-group">
                <label class="control-label">{{ entry_date_start }}</label>
                <div class="input-group date">
                  <input type="text" name="filter_date_start" value="{{ filter_date_start }}" placeholder="YYYY-MM-DD" data-date-format="YYYY-MM-DD" class="form-control" />
                  <span class="input-group-btn"><button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button></span>
                </div>
              </div>
              <div class="form-group">
                <label class="control-label">{{ entry_date_end }}</label>
                <div class="input-group date">
                  <input type="text" name="filter_date_end" value="{{ filter_date_end }}" placeholder="YYYY-MM-DD" data-date-format="YYYY-MM-DD" class="form-control" />
                  <span class="input-group-btn"><button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button></span>
                </div>
              </div>
              <div class="form-group">
                <div class="pull-right">
                    <button type="button" id="button-filter" class="btn btn-primary" data-toggle="tooltip" title="{{ button_filter }}"><i class="fa fa-filter"></i> {{ button_filter }}</button>
                    <button type="button" id="button-clear" class="btn btn-default" data-toggle="tooltip" title="Clear Filters"><i class="fa fa-refresh"></i></button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th class="text-left">{{ column_return_id }}</th>
                <th class="text-left">{{ column_order_id }}</th>
                <th class="text-left">{{ column_customer }}</th>
                <th class="text-left">{{ column_product }}</th>
                <th class="text-left">{{ column_phone }}</th>
                <th class="text-left">{{ column_lot_number }}</th>
                <th class="text-left">{{ column_sku }}</th>
                <th class="text-left">{{ column_quantity }}</th>
                <th class="text-left">{{ column_status }}</th>
                <th class="text-left">{{ column_date_added }}</th>
                <th class="text-right">{{ column_action }}</th>
              </tr>
            </thead>
            <tbody>
              {% if returns %}
              {% for return in returns %}
              <tr>
                <td class="text-left">{{ return.return_id }}</td>
                <td class="text-left">
                  <a href="{{ return.order_href }}" target="_blank" data-toggle="tooltip" title="View Order Details">#{{ return.order_id }}</a>
                </td>
                <td class="text-left">
                    <a href="{{ return.customer_href }}" data-toggle="tooltip" title="Filter by {{ return.customer }}">{{ return.customer }}</a>
                </td>
                <td class="text-left">
                    <a href="{{ return.product_href }}" target="_blank" class="text-info" data-toggle="tooltip" title="View on Website"><i class="fa fa-external-link"></i></a> 
                    {{ return.product }}
                </td>
                <td class="text-left">{{ return.phone }}</td>
                <td class="text-left">{{ return.lot_number }}</td>
                <td class="text-left">{{ return.sku }}</td>
                <td class="text-left">{{ return.quantity }}</td>
                <td class="text-left"><span class="label label-info">{{ return.status }}</span></td>
                <td class="text-left">{{ return.date_added }}</td>
                <td class="text-right">
                  <a href="{{ return.view_return }}" target="_blank" data-toggle="tooltip" title="Edit/View in Sale Return" class="btn btn-primary btn-xs"><i class="fa fa-pencil"></i></a>
                </td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="9">{{ text_no_results }}</td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">

// Filter Button Logic
$('#button-filter').on('click', function() {
    var url = 'index.php?route=extension/module/inventory_module/returns&user_token={{ user_token }}';
    
    $('input[name^=\'filter_\']').each(function() {
        var value = $(this).val();
        if (value) {
            url += '&' + $(this).attr('name') + '=' + encodeURIComponent(value);
        }
    });
    
    location = url;
});

// Clear Button Logic
$('#button-clear').on('click', function() {
    location = 'index.php?route=extension/module/inventory_module/returns&user_token={{ user_token }}';
});

// Datepicker Initialization
$('.date').datetimepicker({
    language: '{{ datepicker }}',
    pickTime: false
});
</script>
{{ footer }}