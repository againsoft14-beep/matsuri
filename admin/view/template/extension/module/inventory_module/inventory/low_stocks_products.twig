{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-export" data-toggle="tooltip" title="Export to CSV" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Export</button>
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-product').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div id="filter-product" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label" for="input-name">{{ entry_name }}</label>
              <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" autocomplete="off" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-sku">{{ entry_sku }}</label>
              <input type="text" name="filter_sku" value="{{ filter_sku }}" placeholder="{{ entry_sku }}" id="input-sku" class="form-control" autocomplete="off" />
            </div>
            <div class="text-right">
              <button type="button" id="button-filter" class="btn btn-primary"><i class="fa fa-filter"></i> {{ button_filter }}</button>
              <button type="button" id="button-reset" class="btn btn-default"><i class="fa fa-refresh"></i> {{ button_reset }}</button>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> {{ heading_title }}</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-center"><a href="{{ sort_sl }}" class="{% if sort == 'p.product_id' %}{{ order|lower }}{% endif %}">SL </a></td>
                <td class="text-left"><a href="{{ sort_category }}" class="{{ sort == 'category' ? order|lower : '' }}">Category</a></td>
                <td class="text-left"><a href="{{ sort_name }}" class="{% if sort == 'pd.name' %}{{ order|lower }}{% endif %}">{{ column_name }}</a></td>
                <td class="text-left"><a href="{{ sort_sku }}" class="{% if sort == 'p.sku' %}{{ order|lower }}{% endif %}">SKU Code</a></td>
                  <td class="text-right">
                      <a href="{{ sort_weight }}" class="{{ sort == 'p.weight' ? order|lower : '' }}">Self Weight</a>
                    </td>
                  <td class="text-right">
                      <a href="{{ sort_unit_weight }}" class="{{ sort == 'p.unit_weight' ? order|lower : '' }}">Weight</a>
                    </td>
                    <td class="text-right">
                      Unit
                    </td>
                    <td class="text-right">
                      <a href="{{ sort_purchase_price }}" class="{{ sort == 'purchase_price' ? order|lower : '' }}">Purchase Price</a>
                    </td>
                   
                   
                <td class="text-right"><a href="{{ sort_price }}" class="{% if sort == 'p.price' %}{{ order|lower }}{% endif %}">Sale Price</a></td>
                <td class="text-right"><a href="{{ sort_quantity }}" class="{% if sort == 'p.quantity' %}{{ order|lower }}{% endif %}">Quantity</a></td>
                <td class="text-center">{{ column_image }}</td>
                <td class="text-right"><a href="{{ sort_status }}" class="{% if sort == 'p.status' %}{{ order|lower }}{% endif %}">Status</a></td>
                <td class="text-right">Action</td>
              </tr>
            </thead>
            <tbody>
              {% if products %}
                {% for product in products %}
                  {# SL Reverse Sorting Logic #}
                  {% if order == 'ASC' %}
                    {% set sl_no = ((pagination_page - 1) * pagination_limit) + loop.index %}
                  {% else %}
                    {% set sl_no = product_total - ((pagination_page - 1) * pagination_limit) - loop.index0 %}
                  {% endif %}
                  
                  <tr>
                    <td class="text-center">{{ sl_no }}</td>
                    <td class="text-left">{{ product.category }}</td>
                    <td class="text-left">{{ product.name }}</td>
                    <td class="text-left">{{ product.sku }}</td>
                    <td class="text-right">{{ product.weight }}</td>
                    <td class="text-right">{{ product.unit_weight }}</td>
                    <td class="text-right">{{ product.weight_class }}</td>
                    <td class="text-right">{{ product.purchase_price }}</td>
                    <td class="text-right">{{ product.price }}</td>
                    <td class="text-right">
                      {% if product.quantity <= 0 %}
                        <span class="label label-danger">{{ product.quantity }}</span>
                      {% else %}
                        <span class="label label-warning">{{ product.quantity }}</span>
                      {% endif %}
                    </td>
                    <td class="text-center">
                      <img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" style="max-width: 40px;" />
                    </td>
                    <td class="text-left">{{ product.status ? "Active" : "InActive" }}</td>
                    <td class="text-right">
                      <a href="{{ product.edit }}" data-toggle="tooltip" title="Edit" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                    </td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td class="text-center" colspan="11">{{ text_no_results }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = 'index.php?route=extension/module/inventory_module/low_stock&user_token={{ user_token }}';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_sku = $('input[name=\'filter_sku\']').val();

	if (filter_sku) {
		url += '&filter_sku=' + encodeURIComponent(filter_sku);
	}

	location = url;
});

$('#button-reset').on('click', function() {
    var url = 'index.php?route=extension/module/inventory_module/low_stock&user_token={{ user_token }}';
    location = url;
});

$('#button-export').on('click', function() {
	var url = 'index.php?route=extension/module/inventory_module/low_stock/export&user_token={{ user_token }}';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_sku = $('input[name=\'filter_sku\']').val();

	if (filter_sku) {
		url += '&filter_sku=' + encodeURIComponent(filter_sku);
	}
    
    var sort = '{{ sort }}';
    if (sort) {
        url += '&sort=' + encodeURIComponent(sort);
    }

    var order = '{{ order }}';
    if (order) {
        url += '&order=' + encodeURIComponent(order);
    }

	location = url;
});

$('#filter-product input').keydown(function(e) {
    if (e.keyCode == 13) {
        $('#button-filter').trigger('click');
    }
});
//--></script>
{{ footer }}