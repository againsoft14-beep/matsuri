{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-gift" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-gift" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-gifted-name">{{ entry_gifted_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="gifted_name" value="{{ gifted_name }}" placeholder="{{ entry_gifted_name }}" id="input-gifted-name" class="form-control" />
              {% if error_gifted_name %}
              <div class="text-danger">{{ error_gifted_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-gift-date">{{ entry_gift_date }}</label>
            <div class="col-sm-3">
              <div class="input-group date">
                <input type="text" name="gift_date" value="{{ gift_date }}" placeholder="{{ entry_gift_date }}" data-date-format="YYYY-MM-DD" id="input-gift-date" class="form-control" />
                <span class="input-group-btn">
                <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                </span></div>
              {% if error_gift_date %}
              <div class="text-danger">{{ error_gift_date }}</div>
              {% endif %}
            </div>
          </div>
          
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-product"><span data-toggle="tooltip" title="(Autocomplete)">{{ entry_product }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="product" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
            </div>
          </div>

          <div class="table-responsive">
            <table id="product-grid" class="table table-bordered">
              <thead>
                <tr>
                  <td class="text-left">{{ column_product }}</td>
                  <td class="text-left">Lot Number</td>
                  <td class="text-right">{{ column_quantity }}</td>
                  <td class="text-right">{{ column_purchase_price }}</td>
                  <td class="text-right">{{ column_additional_cost }}</td>
                  <td></td>
                </tr>
              </thead>
              <tbody>
                {% set product_row = 0 %}
              </tbody>
            </table>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var product_row = {{ product_row }};

$('input[name=\'product\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=extension/module/inventory_module/gift/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'product\']').val('');

    var product_id = item['value'];
    var product_name = item['label'];

    $.ajax({
      url: 'index.php?route=extension/module/inventory_module/gift/getLots&user_token={{ user_token }}&product_id=' + product_id,
      dataType: 'json',
      success: function(json) {
        if (json.length > 0) {
          html  = '<tr id="product-row' + product_row + '">';
          html += '  <td class="text-left"><input type="hidden" name="products[' + product_row + '][product_id]" value="' + product_id + '" />' + product_name + '</td>';
          html += '  <td class="text-left"><select name="products[' + product_row + '][inventory_details_id]" class="form-control lot-select" data-row="' + product_row + '">';
          $.each(json, function(i, lot) {
            html += '    <option value="' + lot['inventory_details_id'] + '" data-price="' + lot['purchase_price'] + '" data-additional="' + lot['additional_cost'] + '" data-max="' + lot['quantity'] + '">' + lot['lot_number'] + ' (Available: ' + lot['quantity'] + ')</option>';
          });
          html += '  </select></td>';
          html += '  <td class="text-right"><input type="number" name="products[' + product_row + '][quantity]" value="1" class="form-control qty-input" min="1" /></td>';
          html += '  <td class="text-right"><input type="text" name="products[' + product_row + '][purchase_price]" value="' + json[0]['purchase_price'] + '" class="form-control" readonly /></td>';
          html += '  <td class="text-right"><input type="text" name="products[' + product_row + '][additional_cost]" value="' + json[0]['additional_cost'] + '" class="form-control" readonly /></td>';
          html += '  <td class="text-left"><button type="button" onclick="$(\'#product-row' + product_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
          html += '</tr>';

          $('#product-grid tbody').append(html);
          product_row++;
        } else {
          alert('No available stock found for this product.');
        }
      }
    });
	}
});

$(document).delegate('.lot-select', 'change', function() {
  var row = $(this).data('row');
  var selected = $(this).find('option:selected');
  $('input[name="products[' + row + '][purchase_price]"]').val(selected.data('price'));
  $('input[name="products[' + row + '][additional_cost]"]').val(selected.data('additional'));
  $('input[name="products[' + row + '][quantity]"]').attr('max', selected.data('max'));
});

$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});
//--></script>
{{ footer }}
