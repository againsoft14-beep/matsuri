{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
          <a href="{{ add }}" data-toggle="tooltip" title="{{ text_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
          <a href="{{ export }}" data-toggle="tooltip" title="Export" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Export</a>
          <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-employee').submit() : false;"><i class="fa fa-trash-o"></i></button>
        </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {{ messages }}
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_employee_list }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-employee">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                  <tr>
                    <td style="width: 1px;" class="text-center">
                      <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
                    </td>
                    <td class="text-center">Image</td>
                
                    <td class="text-left">
                      <a href="{{ sort_name }}" class="{% if sort == 'name' %}{{ order|lower }}{% endif %}">{{ column_name }}</a>
                    </td>
                    
                    <td class="text-left">
                      <a href="{{ sort_designation }}" class="{% if sort == 'designation' %}{{ order|lower }}{% endif %}">{{ column_designation }}</a>
                    </td>
                    
                    <td class="text-left">
                      <a href="{{ sort_email }}" class="{% if sort == 'email' %}{{ order|lower }}{% endif %}">{{ column_email }}</a>
                    </td>
                    
                    <td class="text-left">
                      <a href="{{ sort_mobile }}" class="{% if sort == 'mobile' %}{{ order|lower }}{% endif %}">{{ column_mobile }}</a>
                    </td>
                    
                    <td class="text-right">
                      <a href="{{ sort_salary }}" class="{% if sort == 'salary' %}{{ order|lower }}{% endif %}">{{ column_salary }}</a>
                    </td>
                    
                    <td class="text-center">
                      <a href="{{ sort_status }}" class="{% if sort == 'status' %}{{ order|lower }}{% endif %}">{{ column_status }}</a>
                    </td>
                    
                    <td class="text-right">{{ column_action }}</td>
                  </tr>
                </thead>
              <tbody>
                {% if employees %}
                {% for emp in employees %}
                <tr>
                  <td class="text-center">
                    <input type="checkbox" name="selected[]" value="{{ emp.emp_id }}" />
                  </td>
                  <td class="text-center">
                    {% if emp.image %}
                    <img src="{{ emp.image }}" alt="{{ emp.name }}" class="img-thumbnail" style="width: 40px; height: 40px;" />
                    {% else %}
                    <i class="fa fa-user fa-2x"></i>
                    {% endif %}
                  </td>
                  <td class="text-left"><strong>{{ emp.name }}</strong></td>
                  <td class="text-left"><span class="text-muted">{{ emp.designation }}</span></td>
                  <td class="text-left">{{ emp.email }}</td>
                  <td class="text-left">{{ emp.phone }}</td> {# Note: Using phone as per your DB #}
                  <td class="text-right">{{ emp.salary }}</td>
                  <td class="text-center">
                    {% if emp.status == 1 %}
                    <span class="label label-success">{{ text_enabled }}</span>
                    {% else %}
                    <span class="label label-danger">{{ text_disabled }}</span>
                    {% endif %}
                  </td>
                  <td class="text-right">
                    <a href="{{ emp.edit }}" data-toggle="tooltip" title="{{ text_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                  </td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="9">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

{{ footer }}