{{ header }}{{ column_left }}

<div id="content">
	<link href="view/javascript/bs-colorpicker/css/colorpicker.css" media="screen" rel="stylesheet" type="text/css"/>
	<script src="view/javascript/bs-colorpicker/js/colorpicker.js" type="text/javascript"></script>
	<script src="view/javascript/jquery/jquery-ui/jquery-ui.js"></script>
	<link type="text/css" href="view/javascript/desktop_theme.css" rel="stylesheet" media="screen" />
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="submit" id="button-save" form="form-setting" data-toggle="tooltip"
						title="{{ button_save }}" class="btn btn-info">{{ button_save }}
				</button>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li>
						<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>

	<div class="container-fluid">
		{% if success %}
			<div class="alert alert-success">
				<i class="fa fa-check-circle"></i>
				{{ success }}
				<button class="close" data-dismiss="alert" type="button">&times;</button>
			</div>
		{% endif %}
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible">
				<i class="fa fa-exclamation-circle"></i>
				{{ error_warning }}
				<button class="close" data-dismiss="alert" type="button">&times;</button>
			</div>
		{% endif %}

		<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-setting" class="form-horizontal">
			<div class="panel-wrapper">
				<div class="panel-left">
					<div class="setting-header">{{ heading_title }}</div>
					<ul class="menu list-unstyled">
						<li class="active">
							<a data-toggle="tab" href="#tab-general">
								<i class="fa fa-cog fa-fw"></i>
								{{ tab_general }}</a>
						</li>
						<li>
							<a data-toggle="tab" href="#tab-account-whatsapp">
								<i class="fa fa-whatsapp fw"></i>
								{{ tab_whatsapp }}</a>
						</li>
						<li>
							<a data-toggle="tab" href="#tab-translation">
								<i class="fa fa-language fw"></i>
								{{ tab_translation }}</a>
						</li>

					</ul>
				</div>

				<div class="panel-right">
					<div class="store-header">
						<div class="form-group">

						</div>
					</div>

					<div class="main-content">
						<div class="tab-content">
							<div class="clearfix"></div>
							<div class="tab-pane active" id="tab-general">

								<div class="form-group">
									<label class="col-sm-3">{{ entry_status }}</label>
									<div class="col-sm-9">
										<input type="checkbox" name="status" data-control="checkbox" value="1"
											data-off-label="{{ text_no }}"
											data-on-label="{{ text_yes }}" {% if status %} checked="checked" {% endif %} />
									</div>
								</div>

								<div class="form-group">
									<label class="col-sm-3">{{ entry_type }}</label>
									<div class="col-sm-9">
										<div class="btn-group" data-toggle="buttons" id="chat-button">
											<label class="btn btn-success btn-sm btn-chat {% if type == "wa" %}active{% endif %}" {% if type == "wa" %}active{% endif %}>
												<input type="radio" name="type" value="wa" {% if type == "wa" %}checked="checked"{% endif %}> Whatsapp Button
											</label>
											<label class="btn btn-success btn-sm btn-chat {% if type == "im" %}active{% endif %}" {% if type == "im" %}active{% endif %}>
												<input type="radio" name="type" value="im" {% if type == "im" %}checked="checked"{% endif %}> Instant Messaging
											</label>
											<label class="btn btn-success btn-sm btn-chat {% if type == "tw" %}active{% endif %}" {% if type == "tw" %}active{% endif %}>
												<input type="radio" name="type" value="tw" {% if type == "tw" %}checked="checked"{% endif %}> Tawk.to Chat App
											</label>
											<label class="btn btn-success btn-sm btn-chat {% if type == "fb" %}active{% endif %}" {% if type == "fb" %}active{% endif %}>
												<input type="radio" name="type" value="fb" {% if type == "fb" %}checked="checked"{% endif %}> Facebook Messenger
											</label>
										</div>
									</div>
								</div>

								<div id="tawkto" class="form-group required">
									<label class="col-sm-3">{{ entry_tawkto }}
										<span class="help">
														{{ help_tawkto }}
													</span>
									</label>
									<div class="col-sm-5">
										<input name="tawkto_property_id" type="text" class="form-control"
											value="{{ tawkto_property_id }}">
										{% if error_tawkto %}
											<div class="text-danger">{{ error_tawkto }}</div>
										{% endif %}
									</div>
								</div>

								<div id="fb" class="form-group required">
									<label class="col-sm-3">{{ entry_fb_messenger }}
										<span class="help">
														{{ help_fb_messenger }}
													</span>
									</label>
									<div class="col-sm-5">
										<input name="fb_page_id" type="text" class="form-control" value="{{ fb_page_id }}">
										{% if error_fb %}
											<div class="text-danger">{{ error_fb }}</div>
										{% endif %}
									</div>
								</div>

								<div class="form-group">
									<label class="col-sm-3">{{ entry_desktop }}
										<span class="help">
														{{ help_desktop }}
													</span>
									</label>
									<div class="col-sm-5">
										<input type="checkbox" name="desktop" data-control="checkbox" value="1"
											data-off-label="{{ text_no }}"
											data-on-label="{{ text_yes }}" {% if desktop %} checked="checked" {% endif %} />
									</div>
								</div>
								<div class="form-group">
									<label class="col-sm-3">{{ entry_mobile }}
										<span class="help">
														{{ help_mobile }}
													</span>
									</label>
									<div class="col-sm-5">
										<input type="checkbox" name="mobile" data-control="checkbox" value="1"
											data-off-label="{{ text_no }}"
											data-on-label="{{ text_yes }}" {% if mobile %} checked="checked" {% endif %} />
									</div>
								</div>

								<div class="form-group">
									<label class="col-sm-3">{{ entry_hide_prechattext }}
										<span class="help">
														{{ help_hide_prechattext }}
													</span>
									</label>
									<div class="col-sm-5">
										<input type="checkbox" name="hide_prechattext" data-control="checkbox" value="1"
											data-off-label="{{ text_no }}"
											data-on-label="{{ text_yes }}" {% if hide_prechattext %} checked="checked" {% endif %}
											value="1"/>
									</div>
								</div>

								<div class="form-group">
									<label class="col-sm-3">{{ entry_mobile_compatibility }}
										<span class="help">
														{{ help_mobile_compatibility }}
										</span>
									</label>
									<div class="col-sm-5">
										<input type="checkbox" name="mobile_compatibility" data-control="checkbox" value="1"
											data-off-label="{{ text_no }}"
											data-on-label="{{ text_yes }}" {% if mobile_compatibility %} checked="checked" {% endif %}
											value="1"/>
									</div>
								</div>

								<div class="form-group">
									<label class="col-sm-3">{{ entry_wa_show_homepage }}
										<span class="help">
														{{ help_wa_show_homepage }}
										</span>
									</label>
									<div class="col-sm-5">
										<input type="checkbox" name="wa_show_homepage" data-control="checkbox" value="1"
											data-off-label="{{ text_no }}"
											data-on-label="{{ text_yes }}" {% if wa_show_homepage %} checked="checked" {% endif %}
											value="1"/>
									</div>
								</div>

								<div class="form-group">
									<label class="col-sm-3">{{ entry_button_placement }}
										<span class="help">
														{{ help_button_placement }}
										</span>
									</label>
									<div class="col-sm-5">
										<input type="text" class="form-control" name="button_placement" value="{{ button_placement }}"/>
									</div>
								</div>
								<fieldset>
									<legend>{{ entry_desktop_positioning }}</legend>
									<div class="form-group">
										<label class="col-sm-3">{{ entry_bottom_margin }}
											<span class="help">
														{{ help_bottom_margin }}
													</span>
										</label>
										<div class="col-sm-3">
											<input type="number" name="bottom_margin_desktop" class="form-control"
												value="{{ bottom_margin_desktop }}"/>
										</div>
									</div>

									<div class="form-group">
										<label class="col-sm-3">{{ entry_right_margin }}
											<span class="help">
														{{ help_right_margin }}
													</span>
										</label>
										<div class="col-sm-3">
											<input type="number" name="right_margin_desktop" class="form-control"
												value="{{ right_margin_desktop }}"/>
										</div>
									</div>
								</fieldset>

								<fieldset>
									<legend>{{ entry_mobile_positioning }}</legend>
									<div class="form-group">
										<label class="col-sm-3">{{ entry_bottom_margin }}
											<span class="help">
														{{ help_bottom_margin }}
													</span>
										</label>
										<div class="col-sm-3">
											<input type="number" name="bottom_margin_mobile" class="form-control"
												value="{{ bottom_margin_mobile }}"/>
										</div>
									</div>

									<div class="form-group">
										<label class="col-sm-3">{{ entry_right_margin }}
											<span class="help">
														{{ help_right_margin }}
													</span>
										</label>
										<div class="col-sm-3">
											<input type="number" name="right_margin_mobile" class="form-control"
												value="{{ right_margin_mobile }}"/>
										</div>
									</div>
								</fieldset>

								<div class="form-group">
									<label class="col-sm-3" for="color-scheme">
										{{ entry_color }}
									</label>
									<div class="col-sm-3">
										<div class="input-group colorpicker-component">
											<input id="color-scheme" type="text" name="color" value="{{ color }}"
												class="form-control"/><span class="input-group-addon"
																			id="color-scheme-button">
													<i></i>
												</span>
										</div>
									</div>
								</div>
							</div>

							<div class="tab-pane" id="tab-account-whatsapp">
								<div class="col-sm-3">
									<br>
									<ul class="nav nav-pills nav-stacked" id="address">
										<li class="active">
											<a data-toggle="tab" href="#tab-customer">{{ entry_account_wa }}</a>
										</li>
										{% set wa_row = 1 %}
										{% for whatsapp in whatsapps %}
											<li>
												<a data-toggle="tab" href="#tab-whatsapp{{ wa_row }}">
													<i class="fa fa-minus-circle"
													onclick="$('#address a:first').tab('show'); $('#address a[href=\'#tab-whatsapp{{ wa_row }}\']').parent().remove(); $('#tab-whatsapp{{ wa_row }}').remove();"></i>
													{{ text_whatsapp_account }}
													{{ wa_row }}</a>
											</li>
											{% set wa_row = wa_row + 1 %}
										{% endfor %}
										<li id="account-add">
											<a onclick="addAccount();">
												<i class="fa fa-plus-circle"></i>
												{{ button_whatsapp_add }}</a>
										</li>
									</ul>
								</div>

								<div class="col-sm-9">
									<br>
									<div class="tab-content" id="whatsapp_list">
										{% set wa_row = 1 %}
										{% for whatsapp in whatsapps %}
											<div class="tab-pane" id="tab-whatsapp{{ wa_row }}">
												<div class="form-group">
													<label class="col-sm-3"
														for="whatsapp[{{ wa_row }}][status]">
														{{ entry_enable }}
													</label>
													<div class="col-sm-9">
														<input name="whatsapp[{{ wa_row }}][status]" type="checkbox"
															data-control="checkbox" value="1"
															data-off-label="{{ text_no }}"
															data-on-label="{{ text_yes }}" {% if whatsapp.status %} checked="checked" {% endif %}>
													</div>
												</div>

												<div class="form-group">
													<label class="col-sm-3"
														for="whatsapp[{{ wa_row }}][inline_chat_btn]">
														{{ entry_inline_chat_btn }}
														<span class="help">
														{{ help_inline_chat_btn }}
													</span>
													</label>
													<div class="col-sm-9">
														<input name="whatsapp[{{ wa_row }}][inline_chat_btn]"
															type="checkbox" data-control="checkbox" value="1"
															data-off-label="{{ text_no }}"
															data-on-label="{{ text_yes }}" {% if whatsapp.inline_chat_btn %} checked="checked" {% endif %}>
													</div>
												</div>

												<input type="hidden" name="address[{{ wa_row }}][online_status]"
													value="{{ whatsapp.online_status }}"/>
												<div class="form-group">
													<label class="col-sm-3"
														for="input-whatsapp{{ wa_row }}">{{ entry_online_status }} <span
																class="help">{{ help_online_status }}</span></label>
													<div class="col-sm-9">
														<div class="btn-group btn-group-toggle" data-toggle="buttons">
															<label class="btn btn-success {% if whatsapp.online_status == 1 or whatsapp.online_status == 0 %} active {% endif %}">
																<input type="radio"
																	name="whatsapp[{{ wa_row }}][online_status]"
																	id="option1"
																	autocomplete="off" {% if whatsapp.online_status == 1 or whatsapp.online_status == 0 %} checked {% endif %}
																	value="1"> Online
															</label>
															<label class="btn btn-success {% if whatsapp.online_status == 2 %} active {% endif %}">
																<input type="radio"
																	name="whatsapp[{{ wa_row }}][online_status]"
																	id="option1"
																	autocomplete="off" {% if whatsapp.online_status == 2 %} checked {% endif %}
																	value="2"> Away
															</label>
															<label class="btn btn-success {% if whatsapp.online_status == 3 %} active {% endif %}">
																<input type="radio"
																	name="whatsapp[{{ wa_row }}][online_status]"
																	id="option1"
																	autocomplete="off" {% if whatsapp.online_status == 3 %} checked {% endif %}
																	value="3"> Offline
															</label>
														</div>
													</div>
												</div>
												<div class="form-group">
													<label class="col-sm-3"
														for="input-whatsapp{{ wa_row }}">{{ entry_online_time }}</label>
													<div class="col-sm-9">
														<label class="col-sm-1" style="margin-right: 16px;"
															for="input-whatsapp{{ wa_row }}">{{ entry_from }}</label>
														<div class="col-sm-4">
															<select name="whatsapp[{{ wa_row }}][online_time_from]"
																	class="form-control">
																{% for i in range(1, 24) %}
																	<option value="{{ i }}" {% if i == whatsapp.online_time_from %} selected="selected" {% endif %}>
																		{% if i < 10 %} 0{{ i }}:00{% else %} {{ i }}:00 {% endif %}
																	</option>
																{% endfor %}
															</select>
														</div>
														<label class="col-sm-1"
															for="input-whatsapp{{ wa_row }}">{{ entry_to }}</label>
														<div class="col-sm-4">
															<select name="whatsapp[{{ wa_row }}][online_time_to]"
																	class="form-control">
																{% for i in range(1,24) %}
																	<option value="{{ i }}" {% if i == whatsapp.online_time_to %} selected="selected" {% endif %}>
																		{% if i < 10 %} 0{{ i }}:00{% else %} {{ i }}:00 {% endif %}
																	</option>
																{% endfor %}
															</select>
														</div>

													</div>
												</div>
												<div class="form-group">
													<label class="col-sm-3"
														for="input-whatsapp{{ wa_row }}">{{ entry_away_time }}</label>
													<div class="col-sm-9">
														<label class="col-sm-1" style="margin-right: 16px;"
															for="input-whatsapp{{ wa_row }}">{{ entry_from }}</label>
														<div class="col-sm-4">
															<select name="whatsapp[{{ wa_row }}][away_time_from]"
																	class="form-control">
																{% for i in range(1, 24) %}
																	<option value="{{ i }}" {% if i == whatsapp.away_time_from %} selected="selected" {% endif %}>
																		{% if i < 10 %} 0{{ i }}:00{% else %} {{ i }}:00 {% endif %}
																	</option>
																{% endfor %}
															</select>
														</div>
														<label class="col-sm-1"
															for="input-whatsapp{{ wa_row }}">{{ entry_to }}</label>
														<div class="col-sm-4">
															<select name="whatsapp[{{ wa_row }}][away_time_to]"
																	class="form-control">
																{% for i in range(1,24) %}
																	<option value="{{ i }}" {% if i == whatsapp.away_time_to %} selected="selected" {% endif %}>
																		{% if i < 10 %} 0{{ i }}:00{% else %} {{ i }}:00 {% endif %}
																	</option>
																{% endfor %}
															</select>
														</div>

													</div>
												</div>
												<div class="form-group">
													<label class="col-sm-3"
														for="input-whatsapp{{ wa_row }}">{{ entry_offline_time }}</label>
													<div class="col-sm-9">
														<code>{{ text_offline_time }}</code>
													</div>
												</div>
												<input type="hidden" name="address[{{ wa_row }}][name]"
													value="{{ whatsapp.name }}"/>
												<div class="form-group">
													<label class="col-sm-3"
														for="input-whatsapp{{ wa_row }}">{{ entry_whatsapp_name }}</label>
													<div class="col-sm-5">
														<input type="text" name="whatsapp[{{ wa_row }}][name]"
															value="{{ whatsapp.name }}"
															placeholder="{{ entry_whatsapp_name }}"
															id="input-whatsapp{{ wa_row }}" class="form-control"/>
														{% if error_whatsapp[wa_row].name %}
															<div class="text-danger">{{ error_whatsapp[wa_row].name }}</div>
														{% endif %}
													</div>
												</div>

												<input type="hidden" name="address[{{ wa_row }}][position]"
													value="{{ whatsapp.position }}"/>
												<div class="form-group">
													<label class="col-sm-3"
														for="input-whatsapp{{ wa_row }}">{{ entry_whatsapp_position }}</label>
													<div class="col-sm-5">
														<input type="text" name="whatsapp[{{ wa_row }}][position]"
															value="{{ whatsapp.position }}"
															placeholder="{{ entry_whatsapp_position }}"
															id="input-whatsapp{{ wa_row }}" class="form-control"/>
														{% if error_whatsapp[wa_row].position %}
															<div class="text-danger">{{ error_whatsapp[wa_row].position }}</div>
														{% endif %}
													</div>
												</div>
												<div class="form-group">
													<label class="col-sm-3" for="input-whatsapp1">
														{{ entry_link_type }}
														<span class="help">{{ help_link_type }}</span>
													</label>
													<div class="col-sm-9">
														<div class="btn-group btn-group-toggle link-type" data-toggle="buttons" data-wa-row="{{ wa_row }}">
															<label class="btn btn-success  {% if whatsapp.link_type == 1 or whatsapp.link_type == 0 %}active{% endif %}  btn-sm" onclick="link_type(1, {{wa_row}})">
																<input type="radio" name="whatsapp[{{ wa_row }}][link_type]"  {% if whatsapp.link_type == 1 or whatsapp.link_type == 0 %} checked="checked" {% endif %} value="1"> {{ text_whatsapp_button }}
															</label>
															<label class="btn btn-success {% if whatsapp.link_type == 2 %}active{% endif %}  btn-sm" onclick="link_type(2, {{wa_row}})">
																<input type="radio" name="whatsapp[{{ wa_row }}][link_type]" value="2" {% if whatsapp.link_type == 2 %} checked="checked" {% endif %}> {{ text_custom_link }}
															</label>
														</div>
													</div>
												</div>
												<input type="hidden" name="address[{{ wa_row }}][no_wa]"
													value="{{ whatsapp.no_wa }}"/>
												<input type="hidden" name="address[{{ wa_row }}][wa_country]"
													value="{{ whatsapp.wa_country }}"/>
												<div class="form-group" id="wa-number{{wa_row}}" {% if whatsapp.link_type == 2 %}style
												="display:none;"{% endif %}>
													<label class="col-sm-3">{{ entry_no_wa }}</label>
													<div class="col-sm-9">
														<div class="col-sm-2" style="padding: 0;">
															<span class="marker-down"></span>
															<select data-live-search="true"
																	data-selected="{{ whatsapp.wa_country }}"
																	name="whatsapp[{{ wa_row }}][wa_country]"
																	class="country_code{{ wa_row }}">
															</select>
														</div>
														<div class="col-sm-5">
															<input value="{{ whatsapp.wa_number }}"
																name="whatsapp[{{ wa_row }}][wa_number]" type="text"
																class="form-control" aria-describedby="basic-addon1">
														</div>
													</div>
												</div>
												<div class="form-group" id="custom-link{{wa_row}}" {% if whatsapp.link_type == 1 %}style
												="display:none;"{% endif %}>
													<label class="col-sm-3">{{ text_custom_link }}</label>
													<div class="col-sm-6">
														<input value="{{ whatsapp.custom_link }}"
															name="whatsapp[{{ wa_row }}][custom_link]" type="text"
															class="form-control">
													</div>
												</div>
												<div class="form-group">
													<label class="col-sm-3">
														{{ entry_whatsapp_picture }}
													</label>
													<div class="col-sm-9">
														<a class="img-thumbnail" data-toggle="image" href=""
														id="thumb-icon{{ wa_row }}"><img
																	src="{{ whatsapp.logo_placeholder }}" alt="" title=""
																	data-placeholder="{{ whatsapp.logo_placeholder }}"/></a>
														<input id="thumb-input{{ wa_row }}" type="hidden"
															name="whatsapp[{{ wa_row }}][profile_picture]"
															value="{{ whatsapp.profile_picture }}"/>
													</div>
												</div>

												<div class="form-group">
													<label class="col-sm-3" for="input-sort-order">{{entry_whatsapp_sort_order}}</label>
													<div class="col-sm-3">
														<input type="text" name="whatsapp[{{ wa_row }}][sort_order]" value="{{ whatsapp.sort_order }}" placeholder="{{entry_whatsapp_sort_order}}" id="input-sort-order" class="form-control">
