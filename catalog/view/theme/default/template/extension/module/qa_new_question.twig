<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/1999/REC-html401-19991224/strict.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>{{ title }}</title>
</head>
<body>
<table style="font-family: Verdana,sans-serif; font-size: 11px; color: #374953; width: 600px;">
	<tr>
		<td align="left"><a href="{{ store_url }}" title="{{ store_name }}"><img src="{{ logo }}" alt="{{ store_name }}" style="border: none;" ></a></td>
	</tr>
	<tr>
		<td>&nbsp;</td>
	</tr>
	<tr>
		<td align="left">{{ text_new_question }}</td>
	</tr>
	<tr>
		<td>&nbsp;</td>
	</tr>
	<tr>
		<td align="left" style="background-color: #069; color:#FFF; font-size: 12px; font-weight: bold; padding: 0.5em 1em;">{{ text_question_detail }}</td>
	</tr>
	<tr>
		<td>&nbsp;</td>
	</tr>
	<tr>
		<td align="left">
			{{ text_question }} <strong>{{ question|raw }}</strong><br /><br />
			{{ text_question_author }} {% if question_author %}<strong>{{ question_author }}</strong>{% else %}<em>{{ text_anonymous }}</em>{% endif %}{% if customer_name %} ({{ text_customer_name }} {{ customer_name }}){% endif %}<br />
			{% if question_author_email %}
			{{ text_email }} <strong>{{ question_author_email }}</strong><br />
			{% endif %}
			{% if question_author_phone %}
			{{ text_phone }} <strong>{{ question_author_phone }}</strong><br />
			{% endif %}
			{% if question_author_custom %}
			{{ text_custom }} <strong>{{ question_author_custom }}</strong><br />
			{% endif %}
			{{ text_ip }} <strong>{{ ip_address }}</strong><br />
		</td>
	<tr>
		<td>&nbsp;</td>
	</tr>
	</tr>
	<tr>
		<td align="left" style="background-color: #069; color: #FFF; font-size: 12px; font-weight: bold; padding: 0.5em 1em;"></td>
	</tr>
	<tr>
		<td>&nbsp;</td>
	</tr>
	<tr>
		<td align="center" style="font-size: 10px; border-top: 1px solid #069;"><a href="{{ store_url }}" style="color: #069; font-weight: bold; text-decoration: none;">{{ store_name }}</a> {{ text_powered_by }} <a href="http://www.opencart.com" style="text-decoration: none; color: #374953;">OpenCart</a></td>
	</tr>
</table>
</body>
</html>
