<script type="text/javascript">
    (function () {
        var options = {
            whatsapp: "{{ tel }}", // WhatsApp number
            email: "{{ email }}", // Email
            call: "{{ tel }}", // Call phone number
            company_logo_url: "{{ favicon }}", // URL of company logo (png, jpg, gif)
            greeting_message: "{{ greeting }}", // Text of greeting message
            call_to_action: "{{ call_to_action }}", // Call to action
            button_color: "{{ color }}", // Color of button
            position: "right", // Position may be 'right' or 'left'
            order: "whatsapp,call,email", // Order of buttons
        };
        var proto = document.location.protocol, host = "whatshelp.io", url = proto + "//static." + host;
        var s = document.createElement('script'); s.type = 'text/javascript'; s.async = true; s.src = url + '/widget-send-button/js/init.js';
        s.onload = function () { WhWidgetSendButton.init(host, proto, options); };
        var x = document.getElementsByTagName('script')[0]; x.parentNode.insertBefore(s, x);
    })();
    $(".bottom.right.rectangle").attr('class', 'bottom left rectangle');
</script>