
    <style>
        .hidden {
            display: none !important;
        }
        #full_page_loading {
            background: url('../admin/view/image/payment/bkash-page-loader.gif') no-repeat scroll center center #fff;
            position: absolute;
            height: 100%;
            width: 100%;
            z-index: 9999;
            opacity: 0.5;
            top: 0;
        }
    </style>
<div id="full_page_loading" class="hidden"></div>

{# <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal"> #}
    
        <div class="wrapper" style="text-align: center">
        <img onclick="payment()" style="height: 70px; cursor: pointer"
            src="https://scripts.sandbox.bka.sh/resources/img/bkash_payment.png">
        <button type="submit" id="bKash_button" style="display: none"></button>
    </div>

{# </form> #}


<script>
  $(document).ready(function() {
        showLoading();
        createPayment();

    })

    function createPayment(request) {
        // console.log(agreementID);
        // Amount already checked and verified by the controller
        // because of createRequest function finds amount from this request
        // request['amount'] = "{{total_amount}}"; // max two decimal points allowed
        // request['agreementID'] = agreementID; // max two decimal points allowed

        $.ajax({
             url: 'index.php?route=extension/payment/BkashAutoPayment/createPayment',
            type: 'POST',
            dataType: "text",
            // data: request,
            success: function (data) {
                 data = JSON.parse(data);
                if (data && data.paymentID != null) {
                     hideLoading()
                   location.href = data.bkashURL;
                    // window.open(data.bkashURL, '_blank').focus();
                } else {
                    console.log("error");
                    showErrorMessage(data);
                  
                }
            },
            error: function (err) {
                showErrorMessage(err.responseJSON);

            }
        });
    }




    function showErrorMessage(response) {
        hideLoading();

        let message = 'Unknown Error';

        if (response.hasOwnProperty('errorMessage')) {
            let errorCode = parseInt(response.errorCode);
            let bkashErrorCode = [2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014,
                2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026, 2027, 2028, 2029, 2030,
                2031, 2032, 2033, 2034, 2035, 2036, 2037, 2038, 2039, 2040, 2041, 2042, 2043, 2044, 2045, 2046,
                2047, 2048, 2049, 2050, 2051, 2052, 2053, 2054, 2055, 2056, 2057, 2058, 2059, 2060, 2061, 2062,
                2063, 2064, 2065, 2066, 2067, 2068, 2069, 503, 404
            ];

            if (bkashErrorCode.includes(errorCode)) {
                message = response.errorMessage
            }
        }

        alert(`Payment failed! ${message}`)
    }


    function showLoading() {
        $('#full_page_loading').removeClass('hidden');
    }

    function hideLoading() {
        $('#full_page_loading').addClass('hidden');
    }

</script>

</body>
</html>
