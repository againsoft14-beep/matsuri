{{ header }}
{% if not j3.document.isPopup() %}
<ul class="breadcrumb">
  {% for breadcrumb in breadcrumbs %}
  <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
  {% endfor %}
</ul>
{% if j3.settings.get('pageTitlePosition') == 'top' %}
  <h1 class="title page-title"><span>{{ heading_title }}</span></h1>
{% endif %}
{{ j3.loadController('journal3/layout', 'top') }}
<div id="account-login" class="container">
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    
    <style>
    
.layout-6 #content {
    background: white;
    width: 100% !important; 
    max-width: 450px; 
    margin: 40px auto !important; 
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    float: none !important; 
}

@media (max-width: 767px) {
    .layout-6 #content {
        width: 90% !important; 
        margin: 20px auto !important;
        padding: 15px;
    }

    .form-control {
        width: 100% !important;
    }

    .login-button {
        width: 100% !important;
        display: block;
    }
}
    
    
    </style>
    
    
    <div id="content" class="{{ class }}" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1); border-radius: 10px;">
      {% if j3.settings.get('pageTitlePosition') == 'default' %}
        <h1 class="title page-title">{{ heading_title }}</h1>
      {% endif %}
      {{ content_top }}
      <div class="row login-box">
        {#<div class="col-sm-6">#}
        {#  <div class="well">#}
        {#    <h2 class="title">{{ text_new_customer }}</h2>#}
        {#    <p><strong>{{ text_register }}</strong></p>#}
        {#    <p>{{ text_register_account }}</p>#}
        {#    <div class="buttons">#}
        {#      <div class="pull-right">#}
        {#        <a href="{{ register }}" class="btn btn-primary">{{ button_continue }}</a>#}
        {#      </div>#}
        {#    </div>#}
        {#  </div>#}
        {#</div>#}
        
        <style>
            .forgot-password {
                margin-top: 0px;
                padding-top: 0px;
                margin-bottom: -20px;
                display: flex;
            }
            .login-button{
                background:#01AEED !important;
                font-size: 20px;
            }
            .login-button:hover{
                background:#2BB4B6 !important;
            }
            .login-font{
                color:#F47E2D !important;
                text-decoration:none;
            }
            .login-font:hover{
                color:#1A4B3B !important;
                
            }
        </style>
        
        
        <div class="col-sm-6">
          <div class="well">
{% endif %}
            {#<h2 class="title">Log in to {{ text_returning_customer }}</h2>#}
            <h2 class="title">Enter Your Login Info</h2>
            <p><strong>{{ text_i_am_returning_customer }}</strong></p>
            <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal login-form">
              {#<div class="form-group">#}
              {#  <label class="control-label" for="input-email">{{ entry_email }}</label>#}
              {#  <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />#}
              {#</div>#}
              
              <div class="form-group">
                <label class="control-label" for="input-telephone">Phone</label>
                <input type="text" name="telephone" value="{{ telephone }}" placeholder="Enter Numbar" id="input-telephone" class="form-control" />
              </div>

              {#<div class="forgot-password"><a href="{{ forgotten }}" target="_top" class="login-font" style="color: #EF4A23 !important;">{{ text_forgotten }}?</a></div>#}
              <div class="form-group">
                <label class="control-label" for="input-password">{{ entry_password }}</label>
                <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="form-control" />
                <div class="forgot-password"><a href="{{ forgotten }}" target="_top" class="login-font" >{{ text_forgotten }} </a> <span style="padding:0px 10px;"> | </span> <a href="{{ register }}" class="login-font"> Registration</a></div>
                </div>
                
                <div class="pull-left">
                  <button style="width: 100%; background: #3564AD !important; font-size:15px;" type="submit" class="btn btn-primary login-button" data-loading-text="<span>{{ button_login }}</span>"><span>{{ button_login }}</span></button>
                </div>
              
            {#  <div style="max-width:420px; margin:30px auto; display:flex; align-items:center; font-family: Arial, Helvetica, sans-serif;">#}
    
            {#    <div style="flex:1; height:1px; background:rgba(0,0,0,0.15);"></div>#}
            
            {#    <div class="forgot-password" style="padding:0 12px; display:flex; align-items:center;">#}
            {#        <a  target="_top" class="login-font"#}
            {#           style="font-size:14px; color:rgba(0,0,0,0.55) !important; text-decoration:none;">#}
            {#            Don't have an account?#}
            {#        </a>#}
            {#    </div>#}
    
            {#    <div style="flex:1; height:1px; background:rgba(0,0,0,0.15);"></div>#}
            
            {#</div>#}
              
            {#  <div class="buttons" style="padding:0px; padding-top:0px; padding-bottom:0px;">#}
            {#  <div class="pull-left">#}
            {#    <a href="{{ register }}" class="btn btn-success">Create new account</a>#}
            {#  </div>#}
            {#</div>#}
              
              {% if redirect %}
              <input type="hidden" name="redirect" value="{{ redirect }}" />
              {% endif %}
            </form>
{% if not j3.document.isPopup() %}
          </div>
        </div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{% endif %}
{{ footer }}
